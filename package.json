{
  "name": "sql-loader",
  "version": "2.2.0",
  "description": "Import, validate, and compile .sql files into typed query catalogs — bundler plugins, a Node loader, CLI codegen, PostgreSQL parameter contracts, and zero dependencies",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg.d.ts",
        "default": "./dist/pg.js"
      },
      "require": {
        "types": "./dist/pg.d.cts",
        "default": "./dist/pg.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "sql-loader": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "types.d.ts",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "test:coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "validate:package": "publint && attw --pack",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:package",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostcode7/node-sql-loader.git"
  },
  "keywords": [
    "sql",
    "sql-loader",
    "sql-files",
    "sql-import",
    "raw-sql",
    "query-loader",
    "query-catalog",
    "named-parameters",
    "postgres",
    "postgresql",
    "vite-plugin",
    "rollup-plugin",
    "esbuild-plugin",
    "database",
    "nodejs",
    "typescript",
    "codegen",
    "cli",
    "esm",
    "commonjs",
    "serverless"
  ],
  "author": {
    "name": "Dongju Jung",
    "url": "https://github.com/lostcode7"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lostcode7/node-sql-loader/issues"
  },
  "homepage": "https://github.com/lostcode7/node-sql-loader#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "publint": "^0.3.22",
    "rollup": "^4.62.3",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  }
}
