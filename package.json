{
  "name": "sql-loader",
  "version": "2.0.0-beta.0",
  "description": "Load and compile .sql files into a safe, typed query catalog",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "sql-loader": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostcode7/node-sql-loader.git"
  },
  "keywords": [
    "sql",
    "sql-loader",
    "sql file",
    "query catalog",
    "load sql",
    "sql manager",
    "typescript",
    "codegen"
  ],
  "author": "lostcode7",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lostcode7/node-sql-loader/issues"
  },
  "homepage": "https://github.com/lostcode7/node-sql-loader#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "publint": "^0.3.22",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  }
}
